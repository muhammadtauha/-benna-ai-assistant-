PORT=1942
DB_URL=mongodb://127.0.0.1:27017/benna_assistant
JWT_SECRET=change-me

# AI gateway — either direct Lovable key or the proxy pair
LOVABLE_API_KEY=
BENNA_AI_PROXY_URL=
BENNA_AI_PROXY_SECRET=

# Assistant tuning (all optional)
ASSISTANT_FREE_DAILY_TURNS=15
ASSISTANT_DAILY_CAP=120
ASSISTANT_INTENT_MODEL=openai/gpt-5.6-sol
ASSISTANT_REPLY_MODEL=openai/gpt-5.6-sol
ASSISTANT_SIM_FLOOR=0.42

# Optional semantic search (pgvector catalog mirror). Leave unset to skip —
# retrieval falls back to Mongo keyword search automatically.
PG_URL=
# SUPABASE_DB_URL=   (alternative name accepted by helpers/pgClient.js)
